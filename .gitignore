# Secrets. Never committed, not even temporarily.
.env
.env.*
!.env.example
# The Codemagic token belongs in ~/.codemagic-token, outside the repo entirely. This is
# only a backstop in case one ever lands here by accident.
.codemagic-token
*token*.txt

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Collected data — regenerate by running the collector, don't version it.
*.db
*.db-journal
*.sqlite
*.sqlite3
data/

# Downloaded GTFS bundles (~110 MB). Re-fetch with `nextstop gtfs-refresh`.
# stops.json is NOT ignored: it is small, hand-checked, and a diff in it means
# TfNSW renumbered something, which is worth seeing.
gtfs_cache/

# Xcode project files are generated from project.yml on the Mac (brief §6).
*.xcodeproj
*.xcworkspace
DerivedData/
.swiftpm/
*.xcuserstate

# Generated by XcodeGen from project.yml — Info.plists and entitlements.
ios/Generated/

.DS_Store
Thumbs.db
