# Copy to .env and fill in. .env is gitignored and must stay that way.

# https://opendata.transport.nsw.gov.au -> Applications -> Create Application.
# Subscribe the application to at least "Trip Planner" and "Public Transport - Realtime".
NEXTSTOP_TFNSW_API_KEY=

# Google Cloud project with billing enabled and the Routes API turned on.
NEXTSTOP_GOOGLE_API_KEY=

# Shared secret the iOS Shortcuts send in the X-NextStop-Token header so the
# ground-truth endpoint isn't open to the internet.
NEXTSTOP_INGEST_TOKEN=

# Optional overrides.
# NEXTSTOP_DATABASE_URL=sqlite:///nextstop.db
# NEXTSTOP_DAILY_QUOTA=60000
# NEXTSTOP_REQUESTS_PER_SECOND=5.0
